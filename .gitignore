# Sensitive VPN configuration files
vpn/openvpn.ovpn
vpn/credentials

# VPN certificates and keys
*.ovpn
*.key
*.crt
*.pem
*.p12
*.pkcs12

# Keep templates in git
!vpn/*.template

# Build context: `task sandbox:build` exports the dotfiles here before calling docker
.build/

# Docker artifacts
.dockerignore

# Secret files
secrets/
*.secret
.env
.env.local
